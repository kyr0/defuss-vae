{
  "servers": {
    "consensus": {"type": "http", "url": "https://mcp.consensus.app/mcp",
                  "headers": {"Authorization": "Bearer ${CONSENSUS_API_KEY}"}, "disabled": true},
    "zai-web-search": {"type": "http", "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
                       "headers": {"Authorization": "Bearer ${ZAI_API_KEY}"}, "disabled": true},
    "zai-web-reader": {"type": "http", "url": "https://api.z.ai/api/mcp/web_reader/mcp",
                       "headers": {"Authorization": "Bearer ${ZAI_API_KEY}"}, "disabled": true},
    "zai-zread": {"type": "http", "url": "https://api.z.ai/api/mcp/zread/mcp",
                  "headers": {"Authorization": "Bearer ${ZAI_API_KEY}"}, "disabled": true},
    "zai-vision": {"type": "stdio", "command": "npx", "args": ["-y", "@z_ai/mcp-server@latest"],
                   "env": {"Z_AI_API_KEY": "${ZAI_API_KEY}", "Z_AI_MODE": "ZAI"}, "disabled": true}
  },
  "capabilities": {
    "websearch": [{"server": "zai-web-search", "tool": "web_search_prime", "args": {"search_query": "$query"}}],
    "webscrape": [{"builtin": "cloak"}, {"server": "zai-web-reader", "tool": "webReader", "args": {"url": "$url"}}],
    "pdf": [{"server": "zai-web-reader", "tool": "webReader", "args": {"url": "$url"}}],
    "paper_search": [{"server": "consensus", "tool": "search", "args": {"query": "$query"}}],
    "ocr": [{"server": "zai-vision", "tool": "extract_text_from_screenshot",
             "args": {"image_source": "$image", "prompt": "Extract all text in the image verbatim, in reading order."}},
            {"model": "vision", "args": {"image": "$image", "prompt": "Extract all text in the image verbatim, in reading order."}}],
    "vision": [{"server": "zai-vision", "tool": "analyze_image", "args": {"image_source": "$image", "prompt": "$prompt"}}, {"model": "vision"}],
    "video": [{"server": "zai-vision", "tool": "analyze_video", "args": {"video_source": "$video", "prompt": "$prompt"}}],
    "repo_search": [{"server": "zai-zread", "tool": "search_doc", "args": {"repo_name": "$repo", "query": "$query"}}],
    "repo_file": [{"server": "zai-zread", "tool": "read_file", "args": {"repo_name": "$repo", "file_path": "$path"}},
                  {"builtin": "cloak", "args": {"url": "https://raw.githubusercontent.com/$repo/HEAD/$path"}}],
    "repo_tree": [{"server": "zai-zread", "tool": "get_repo_structure", "args": {"repo_name": "$repo", "dir_path": "$path"}}]
  },
  "timeout_s": 30,
  "start_timeout_s": 120
}
