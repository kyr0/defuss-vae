# Environment the defuss-vae programs read. None is required and none holds a secret.

# 0 turns off the daily release check the session-start hook runs in the background (vae_update.check).
VAE_UPDATE_CHECK=1
# Where the release check reads the released manifest; tests point it at a local server or a file:// URL.
VAE_UPDATE_URL=https://raw.githubusercontent.com/kyr0/defuss-vae/main/plugin/.claude-plugin/plugin.json
# Cache root for the release check, empty = ~/.cache (the record lands in <root>/defuss-vae/update.json).
XDG_CACHE_HOME=
# The CloakBrowser executable research reads web pages with; empty = the newest build in CLOAKBROWSER_CACHE_DIR (vae_cloak).
CLOAKBROWSER_BINARY_PATH=
# Where CloakBrowser's builds are installed, empty = ~/.cloakbrowser (tests/site/install-cloakbrowser.sh installs there).
CLOAKBROWSER_CACHE_DIR=

# Read only by the test fixtures; the tests set them themselves (never set them for real use).
# The stdio MCP fixture returns FIXTURE_TOKEN, which its config fills from the secret file (tests/fixtures/mcp_fixture.py).
FIXTURE_TOKEN=
# test_net sets both to show that a .vae/.env.<name> value wins over the process environment.
VAE_TEST_KEY=
VAE_TEST_ONLY_ENV=
